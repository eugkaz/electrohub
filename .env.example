# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS (used by Django and by the postgres container)
POSTGRES_HOST=viva_postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_NAME=projectdb
POSTGRES_DB=projectdb

# Nginx
NGINX_EXTERNAL_PORT=8080

# External APIs
ORS_API_KEY=          # openrouteservice.org — routes to charging stations
OCM_API_KEY=          # openchargemap.org — charging station data
AI_API_KEY=           # Google Gemini — AI assistant

# Stripe (test mode)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# macOS only, if GDAL/PROJ are installed via Homebrew
# DYLD_LIBRARY_PATH=/opt/homebrew/lib
# PROJ_LIB=/opt/homebrew/share/proj
